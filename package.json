{
    "name": "obsidian-map",
    "version": "0.0.1",
    "description": "A navigable world map view over geotagged notes in your vault.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "deploy": "node scripts/deploy.mjs",
        "build:deploy": "npm run build && npm run deploy",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "compile": "tsc -noEmit --skipLibCheck",
        "lint": "prettier --check 'src/**/*.ts'",
        "fix-lint": "prettier --write 'src/**/*.ts'",
        "test": "jest --ci --silent=true --passWithNoTests",
        "test-dev": "jest --watch"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "map",
        "geo"
    ],
    "author": "TheMailman123",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.2",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.28.1",
        "jest": "^29.7.0",
        "obsidian": "^1.13.1",
        "prettier": "^2.8.8",
        "ts-jest": "^29.4.12",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {}
}
